# Optional integrated stack image. Build with repository root as context:
# docker compose -f docker-compose.fullstack.yml up --build
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

COPY ai-services/requirements.txt ./requirements.txt
RUN python -m pip install --upgrade pip \
    && pip install -r requirements.txt

COPY ai-services/app ./app

RUN useradd --create-home --uid 1000 appuser \
    && mkdir -p /app/chroma_db /shared-documents \
    && chown -R appuser:appuser /app /shared-documents
USER appuser

EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
