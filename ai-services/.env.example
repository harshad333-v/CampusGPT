# CampusGPT AI Service environment template
# Copy this file to .env for local development. Never commit real credentials.
# Production secrets belong in the hosting platform's secret manager.

APP_ENV=development
LOG_LEVEL=INFO

# Existing Gemini-compatible gateway (same generation integration)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=http://127.0.0.1:8081/v1
GEMINI_API_KEY=not-needed

# Local development defaults. Keep these for the existing Chroma/Ollama setup.
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=campusgpt
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_DIMENSIONS=768
OLLAMA_BASE_URL=http://127.0.0.1:11434

# To connect this service to the existing Supabase project, configure these
# values locally in .env (or in your deployment secret manager), never commit them.
# Supabase project URL: https://uoopgnbpdazpuokjduol.supabase.co
# VECTOR_STORE_BACKEND=supabase
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_MODEL=voyage-4-lite
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_API_KEY=YOUR_VOYAGE_API_KEY
# DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_DB_PASSWORD@db.uoopgnbpdazpuokjduol.supabase.co:5432/postgres?sslmode=require
# PGVECTOR_COLLECTION_NAME=campusgpt

# Database connection pool (server-side only)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
