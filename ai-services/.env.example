# CampusGPT AI service — local development profile
# Copy to .env. Never commit .env or real credentials.
#
# Generation uses your OpenAI-compatible Gemini Web API gateway.
# Embeddings and vector storage run locally (Ollama + ChromaDB).

APP_ENV=development
LOG_LEVEL=INFO

# Gemini Web API gateway must support POST /v1/chat/completions.
# Change GEMINI_MODEL to a model ID exposed by your gateway if necessary.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=http://127.0.0.1:8081/v1
GEMINI_API_KEY=not-needed

# LOCAL embeddings: Ollama. Pull this model with: ollama pull nomic-embed-text
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_DIMENSIONS=768
OLLAMA_BASE_URL=http://127.0.0.1:11434

# LOCAL vector database. Data persists in ai-services/chroma_db.
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=campusgpt

# Optional hosted mode only — do not uncomment for local-only operation.
# VECTOR_STORE_BACKEND=supabase
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_MODEL=voyage-4-lite
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_API_KEY=YOUR_VOYAGE_API_KEY
# DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/postgres?sslmode=require
# PGVECTOR_COLLECTION_NAME=campusgpt
# PGVECTOR_SCHEMA_NAME=campusgpt

# PostgreSQL connection pool (used only when VECTOR_STORE_BACKEND=supabase).
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Optional OCR location if Tesseract is installed outside its default Windows path.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
