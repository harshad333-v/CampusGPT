# CampusGPT AI Service environment template
# Copy to .env for local development. Never put real secrets in this file.
# Production secrets should be injected by the hosting provider's secrets manager.

APP_ENV=development
LOG_LEVEL=INFO

# Existing Gemini-compatible WebSocket gateway / OpenAI-compatible endpoint
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=http://127.0.0.1:8081/v1
GEMINI_API_KEY=replace-with-gateway-key-if-required

# Vector backend: chroma (existing local behavior) or supabase (production target)
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=campusgpt

# Hosted embedding provider configuration for the Supabase backend.
# Implement and test the selected provider before setting VECTOR_STORE_BACKEND=supabase.
EMBEDDING_PROVIDER=voyage
EMBEDDING_API_KEY=replace-with-provider-key
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_DIMENSIONS=1024

# Supabase PostgreSQL: use the server-side direct/session pooler connection string.
# Do not expose DATABASE_URL or service-role credentials to the frontend.
DATABASE_URL=postgresql://postgres:replace-me@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-secret-if-used
PGVECTOR_TABLE=campusgpt_chunks
PGVECTOR_INDEX_TYPE=hnsw

# Retrieval
RAG_TOP_K=5
RAG_TIMETABLE_TOP_K=10
