# Full-stack local Docker profile. Copy this file to .env.fullstack.
# Never commit .env.fullstack or real credentials.
# MongoDB is container-network-local; these defaults are for Docker Compose.
MONGO_URI=mongodb://mongo:27017/campusgpt

# Generate locally with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# Generation uses your OpenAI-compatible Gemini Web API gateway on the host.
# The gateway must expose POST /v1/chat/completions and stay running.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=http://host.docker.internal:8081/v1
GEMINI_API_KEY=not-needed

# Local embedding model used by the Ollama container.
OLLAMA_MODEL=nomic-embed-text:latest

# Optional SMTP settings for password reset email.
FRONTEND_URL=http://localhost:5173
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=CampusGPT
