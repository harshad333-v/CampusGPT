# COPY to .env.fullstack, fill real values, and never commit it.
# Both URLs should point to the same Supabase PostgreSQL database, but use separate
# connections: backend queries campus_app; FastAPI/LangChain queries campusgpt.
CAMPUS_DATABASE_URL=postgresql://POOLER_USER:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
AI_DATABASE_URL=postgresql://POOLER_USER:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Generate a secret; do not deploy this placeholder.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

VOYAGE_API_KEY=YOUR_VOYAGE_API_KEY
GEMINI_MODEL=gemini-3.6-flash
# For Windows/macOS Docker Desktop, this points from the AI container to the host gateway.
# Ensure gemini-web2api is running on port 8081. In production, use its private service URL.
GEMINI_BASE_URL=http://host.docker.internal:8081/v1
GEMINI_API_KEY=not-needed

# Optional: bootstrap admin during a manual command, not during container startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=CampusGPT Administrator
