# Copy to backend/.env and fill in a unique secret.
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/campusgpt
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d
COOKIE_NAME=campusgpt_session
COOKIE_SECURE=false
CLIENT_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# FastAPI AI service; Ollama and Gemini configuration belongs in ai-services/.env.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=120000

# In local multi-process development, the backend and AI service must see this same path.
SHARED_DOCUMENTS_DIR=./uploads
MAX_UPLOAD_MB=20

# Optional SMTP settings for password reset email flows.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=CampusGPT
