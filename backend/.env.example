# Copy to .env. Never commit your real .env.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Web metadata/auth tables are isolated in the campus_app schema.
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_SSL=true
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
COOKIE_NAME=campusgpt_session
COOKIE_SECURE=false

# Existing FastAPI AI service
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=120000

# Must be readable at this same path by backend and AI service.
SHARED_DOCUMENTS_DIR=../shared-documents
MAX_UPLOAD_MB=20

# Optional; run npm run bootstrap:admin explicitly after configuring these.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=CampusGPT Administrator
